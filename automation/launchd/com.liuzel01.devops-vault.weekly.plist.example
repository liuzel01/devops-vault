<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
  <key>Label</key>
  <string>com.liuzel01.devops-vault.weekly</string>
  <key>ProgramArguments</key>
  <array>
    <string>/bin/zsh</string>
    <string>/Users/liuzelin/github/devops-vault/scripts/run-scheduled-weekly.zsh</string>
  </array>
  <key>WorkingDirectory</key>
  <string>/Users/liuzelin/github/devops-vault</string>
  <key>EnvironmentVariables</key>
  <dict>
    <key>DEVOPS_VAULT_DIR</key>
    <string>/Users/liuzelin/github/devops-vault</string>
    <key>DEVOPS_VAULT_NODE</key>
    <string>/Users/liuzelin/.nvm/versions/node/v22.22.3/bin/node</string>
    <key>DEVOPS_VAULT_WEEKLY_GENERATOR</key>
    <string>/absolute/path/to/openclaw-weekly-adapter</string>
  </dict>
  <key>StartCalendarInterval</key>
  <dict>
    <key>Weekday</key><integer>1</integer>
    <key>Hour</key><integer>9</integer>
    <key>Minute</key><integer>10</integer>
  </dict>
  <key>StandardOutPath</key>
  <string>/Users/liuzelin/Library/Logs/devops-vault-weekly.log</string>
  <key>StandardErrorPath</key>
  <string>/Users/liuzelin/Library/Logs/devops-vault-weekly.error.log</string>
</dict>
</plist>
